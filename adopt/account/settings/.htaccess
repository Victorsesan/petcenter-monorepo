# TASK-WEB-04 START — Route private account settings through server-side authorization.
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^index\.html$ /account/settings/ [R=302,L,NC]
<IfModule mod_authz_core.c>
    <Files "index.html">
        Require all denied
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    <Files "index.html">
        Order allow,deny
        Deny from all
    </Files>
</IfModule>
# TASK-WEB-04 END
